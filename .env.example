# Copy to .env and edit. Loaded automatically at startup.

# Run without real hardware: instruments return plausible fake readings and
# serial devices echo canned responses. Lets you build and dry-run a tester
# on any PC before the bench exists.
SIMULATE=false

# Default log level for the CLI (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Operator name recorded in every result file
OPERATOR=cj
